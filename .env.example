# Set true for clearly labelled scripted MOCK responses, even if a key is configured.
MOCK_LLM=false
# Gemini uses the OpenAI-compatible chat completions endpoint configured below.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
